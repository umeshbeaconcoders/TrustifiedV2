{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["react-native", "jest", "nativewind/types"]
  },
  "include": ["src", "App.tsx", "index.js", "global.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "ios", "android"]
}
